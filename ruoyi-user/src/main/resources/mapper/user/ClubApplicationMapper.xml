        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectClubApplicationVo">
        select application_id, club_id, club_name, user_id, user_name, nick_name, student_id, real_name, gender, major, grade, class_name, phone, email, self_introduction, apply_reason, special_skills, application_time, review_status, reviewer_id, reviewer_name, review_time, review_comment, del_flag, create_by, create_time, update_by, update_time, remark from club_application
    </sql>

    <select id="selectClubApplicationList" parameterType="com.ruoyi.user.domain.ClubApplication" resultMap="ClubApplicationResult">
        <include refid="selectClubApplicationVo"/>
        <where>  
            del_flag = '0'
            <if test="clubId != null "> and club_id = #{clubId}</if>
            <if test="clubName != null  and clubName != ''"> and club_name like concat('%', #{clubName}, '%')</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="nickName != null  and nickName != ''"> and nick_name like concat('%', #{nickName}, '%')</if>
            <if test="realName != null  and realName != ''"> and real_name like concat('%', #{realName}, '%')</if>
            <if test="status != null  and status != ''"> and review_status = #{status}</if>
        </where>
        order by application_time desc
    </select>
    
    <select id="selectClubApplicationById" parameterType="Long" resultMap="ClubApplicationResult">
        <include refid="selectClubApplicationVo"/>
        where application_id = #{applicationId}
    </select>
        
    <insert id="insertClubApplication" parameterType="com.ruoyi.user.domain.ClubApplication" useGeneratedKeys="true" keyProperty="applicationId">
        insert into club_application
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="clubId != null">club_id,</if>
            <if test="clubName != null">club_name,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="nickName != null">nick_name,</if>
            <if test="studentId != null and studentId != ''">student_id,</if>
            <if test="realName != null and realName != ''">real_name,</if>
