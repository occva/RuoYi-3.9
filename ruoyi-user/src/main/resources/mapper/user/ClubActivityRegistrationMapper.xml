<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.user.mapper.ClubActivityRegistrationMapper">
    
    <resultMap type="com.ruoyi.user.domain.ClubActivityRegistration" id="ClubActivityRegistrationResult">
        <result property="registrationId"    column="registration_id"    />
        <result property="activityId"    column="activity_id"    />
        <result property="clubId"    column="club_id"    />
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="nickName"    column="nick_name"    />
        <result property="studentId"    column="student_id"    />
        <result property="phone"    column="phone"    />
        <result property="registrationTime"    column="registration_time"    />
        <result property="checkInStatus"    column="check_in_status"    />
        <result property="checkInTime"    column="check_in_time"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="activityTitle" column="activity_title" />
        <result property="clubName"      column="club_name"     />
        <result property="avatar"        column="avatar"        />
    </resultMap>

    <sql id="selectClubActivityRegistrationVo">
        select r.registration_id, r.activity_id, r.club_id, r.user_id, r.user_name, r.nick_name, r.student_id, r.phone, r.registration_time, r.check_in_status, r.check_in_time, r.status, r.del_flag,
               a.activity_title, c.club_name, u.avatar
        from club_activity_registration r
        left join club_activity a on r.activity_id = a.activity_id
        left join club c on r.club_id = c.club_id
        left join sys_user u on r.user_id = u.user_id
    </sql>

    <select id="selectClubActivityRegistrationList" parameterType="com.ruoyi.user.domain.ClubActivityRegistration" resultMap="ClubActivityRegistrationResult">
        <include refid="selectClubActivityRegistrationVo"/>
        <where>  
            r.del_flag = '0'
            <if test="activityId != null "> and r.activity_id = #{activityId}</if>
            <if test="clubId != null "> and r.club_id = #{clubId}</if>
            <if test="userId != null "> and r.user_id = #{userId}</if>
            <if test="nickName != null  and nickName != ''"> and r.nick_name like concat('%', #{nickName}, '%')</if>
            <if test="status != null  and status != ''"> and r.status = #{status}</if>
            <if test="checkInStatus != null  and checkInStatus != ''"> and r.check_in_status = #{checkInStatus}</if>
            <if test="params != null and params.clubIds != null and params.clubIds.size() > 0">
                and r.club_id in
                <foreach collection="params.clubIds" item="cid" open="(" separator="," close=")">#{cid}</foreach>
            </if>
        </where>
        order by r.registration_time desc
    </select>
    
    <select id="selectClubActivityRegistrationById" parameterType="Long" resultMap="ClubActivityRegistrationResult">
        <include refid="selectClubActivityRegistrationVo"/>
        where r.registration_id = #{registrationId}
    </select>
        
    <insert id="insertClubActivityRegistration" parameterType="com.ruoyi.user.domain.ClubActivityRegistration" useGeneratedKeys="true" keyProperty="registrationId">
        insert into club_activity_registration
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="activityId != null">activity_id,</if>
            <if test="clubId != null">club_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="nickName != null">nick_name,</if>
            <if test="studentId != null">student_id,</if>
            <if test="phone != null">phone,</if>
            <if test="registrationTime != null">registration_time,</if>
            <if test="checkInStatus != null">check_in_status,</if>
            <if test="checkInTime != null">check_in_time,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="activityId != null">#{activityId},</if>
            <if test="clubId != null">#{clubId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="nickName != null">#{nickName},</if>
            <if test="studentId != null">#{studentId},</if>
            <if test="phone != null">#{phone},</if>
            <if test="registrationTime != null">#{registrationTime},</if>
            <if test="checkInStatus != null">#{checkInStatus},</if>
            <if test="checkInTime != null">#{checkInTime},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateClubActivityRegistration" parameterType="com.ruoyi.user.domain.ClubActivityRegistration">
        update club_activity_registration
        <trim prefix="SET" suffixOverrides=",">
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="clubId != null">club_id = #{clubId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="nickName != null">nick_name = #{nickName},</if>
            <if test="studentId != null">student_id = #{studentId},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="registrationTime != null">registration_time = #{registrationTime},</if>
            <if test="checkInStatus != null">check_in_status = #{checkInStatus},</if>
            <if test="checkInTime != null">check_in_time = #{checkInTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where registration_id = #{registrationId}
    </update>

    <update id="cancelActiveRegistration">
        update club_activity_registration
        set status = '2'
        where activity_id = #{activityId}
          and user_id = #{userId}
          and del_flag = '0'
          and status != '2'
    </update>

    <delete id="deleteClubActivityRegistrationById" parameterType="Long">
        update club_activity_registration set del_flag = '2' where registration_id = #{registrationId}
    </delete>

    <delete id="deleteClubActivityRegistrationByIds" parameterType="Long">
        update club_activity_registration set del_flag = '2' where registration_id in 
        <foreach item="registrationId" collection="array" open="(" separator="," close=")">
            #{registrationId}
        </foreach>
    </delete>
</mapper>
