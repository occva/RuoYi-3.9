    <delete id="deleteClubApplicationById" parameterType="Long">
        update club_application set del_flag = '2' where application_id = #{applicationId}
    </delete>

    <delete id="deleteClubApplicationByIds" parameterType="Long">
        update club_application set del_flag = '2' where application_id in 
        <foreach item="applicationId" collection="array" open="(" separator="," close=")">
            #{applicationId}
        </foreach>
    </delete>
    <select id="selectStatusStat" resultType="java.util.Map">
        SELECT review_status as status, count(*) as count 
        FROM club_application 
        WHERE del_flag = '0' 
        GROUP BY review_status
    </select>

    <select id="selectTrendStat" resultType="java.util.Map">
        SELECT DATE_FORMAT(application_time, '%m-%d') as day, count(*) as count 
        FROM club_application 
        WHERE del_flag = '0' 
          AND application_time >= DATE_SUB(CURDATE(), INTERVAL 30 DAY)
        GROUP BY day
        ORDER BY day ASC
    </select>

    <select id="selectClubRankingStat" resultType="java.util.Map">
        SELECT club_name as clubName, count(*) as count 
        FROM club_application 
        WHERE del_flag = '0' 
        GROUP BY club_name 
        ORDER BY count DESC 
        LIMIT 10
    </select>
