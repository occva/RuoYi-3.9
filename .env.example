# Copy this file to .env and fill in real values.
# Keep .env local and never commit secrets.

# Paths and logging
RUOYI_PROFILE_PATH=./uploadPath
RUOYI_LOG_PATH=./logs
RUOYI_LOG_LEVEL=info
RUOYI_SPRING_LOG_LEVEL=warn

# MySQL
RUOYI_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/ry_vue?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8
RUOYI_DATASOURCE_USERNAME=root
RUOYI_DATASOURCE_PASSWORD=

# Redis
RUOYI_REDIS_HOST=127.0.0.1
RUOYI_REDIS_PORT=6379
RUOYI_REDIS_DATABASE=0
RUOYI_REDIS_PASSWORD=

# JWT
RUOYI_TOKEN_SECRET=change-this-token-secret-at-least-32-chars

# AI / Mongo
AI_CHAT_ENABLED=false
RUOYI_MONGODB_URI=mongodb://127.0.0.1:27017/association_chat
AI_CHAT_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_CHAT_API_KEY=
OPENROUTER_API_KEY=
AI_CHAT_MODEL=google/gemini-3-flash-preview
AI_CHAT_MAX_TOKENS=1024
AI_CHAT_TEMPERATURE=0.7
AI_CHAT_REASONING_ENABLED=true
