# Copy this file to .env and fill in real values.
# Keep .env local and never commit secrets.

AI_CHAT_ENABLED=true
AI_CHAT_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_CHAT_API_KEY=YOUR_API_KEY
OPENROUTER_API_KEY=YOUR_API_KEY

AI_CHAT_MODEL=google/gemini-3-flash-preview
AI_CHAT_MAX_TOKENS=1024
AI_CHAT_TEMPERATURE=0.7
AI_CHAT_REASONING_ENABLED=true
